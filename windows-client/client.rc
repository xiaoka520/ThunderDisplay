#include <windows.h>
#include "version.h"
#include "resource.h"
IDI_THUNDERDISPLAY ICON "assets/ThunderDisplay.ico"
IDI_THUNDERDISPLAY_DARK ICON "assets/ThunderDisplayDark.ico"
IDI_THUNDERDISPLAY_STATUS ICON "assets/ThunderDisplayStatus.ico"
IDI_THUNDERDISPLAY_STATUS_LIGHT ICON "assets/ThunderDisplayStatusLight.ico"
1 RT_MANIFEST "client.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION TD_VERSION_NUMBERS
 PRODUCTVERSION TD_VERSION_NUMBERS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ThunderDisplay Client\0"
   VALUE "FileVersion", TD_VERSION_RESOURCE
   VALUE "ProductName", "ThunderDisplay\0"
   VALUE "ProductVersion", TD_VERSION_RESOURCE
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
